# AIsidian — copy to .env (or paste into the Portainer stack variables).
# Never commit the real values. Secrets belong in Vaultwarden / Portainer.

# --- Images
AISIDIAN_IMAGE_PREFIX=ghcr.io/joblinours/aisidian
AISIDIAN_TAG=latest              # latest | vX.Y.Z | dev
LIVESYNC_CLI_TAG=latest
COUCHDB_TAG=3.5

# --- Host
PUID=1000
PGID=1000
TZ=Europe/Paris
BIND_ADDRESS=0.0.0.0             # LAN address of the Docker host if you want to restrict
CONFIG_DIR=./config              # contains permissions.yaml (optional), backed up

# --- CouchDB (LiveSync)
COUCHDB_PORT=5984
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=change-me
COUCHDB_DATABASE=obsidian
COUCHDB_SYNC_USER=livesync
COUCHDB_SYNC_PASSWORD=change-me

# --- MCP server
PUBLIC_URL=https://notes.example.com   # public URL routed by the Cloudflare Tunnel to MCP_PORT
MCP_PORT=8080
MCP_STATUS_PORT=9101                   # LAN only, for Zabbix
AGENT_MODE=simulation                  # simulation | real
AGENT_MAX_WRITES=50
PERMISSIONS_FILE=                      # e.g. /config/permissions.yaml (defaults match the spec)
ALLOWED_REDIRECT_URIS=                 # default: claude.ai and claude.com MCP callbacks (+ loopback)
CIMD_ALLOWED_HOSTS=                    # default: claude.ai,claude.com
TRUST_PROXY=1
GIT_AUTHOR_NAME=AIsidian
GIT_AUTHOR_EMAIL=aisidian@localhost

# --- Backups
RESTIC_REPOSITORY_PATH=/mnt/backup/aisidian-restic   # DAS mount on the Docker host
RESTIC_PASSWORD=change-me
BACKUP_MINUTE=5

# --- Fallback (only with --profile fallback)
OBSIDIAN_FALLBACK_PORT=3000
