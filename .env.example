# AIsidian — copy to .env (or paste into the Portainer stack variables).
# Never commit the real values. Secrets belong in Vaultwarden / Portainer.

# --- Images
AISIDIAN_IMAGE_PREFIX=ghcr.io/joblinours/aisidian
# latest | vX.Y.Z | dev
AISIDIAN_TAG=latest
LIVESYNC_CLI_TAG=latest
COUCHDB_TAG=3.5

# --- Host
PUID=1000
PGID=1000
TZ=Europe/Paris
# LAN address of the Docker host if you want to restrict
BIND_ADDRESS=0.0.0.0
# contains permissions.yaml (optional), backed up
CONFIG_DIR=./config

# --- CouchDB (LiveSync)
COUCHDB_PORT=5984
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=change-me
COUCHDB_DATABASE=obsidian
COUCHDB_SYNC_USER=livesync
COUCHDB_SYNC_PASSWORD=change-me

# --- MCP server
# public URL routed by the Cloudflare Tunnel to MCP_PORT
PUBLIC_URL=https://notes.example.com
MCP_PORT=8080
# LAN only, for Zabbix
MCP_STATUS_PORT=9101
# simulation | real
AGENT_MODE=simulation
AGENT_MAX_WRITES=50
# e.g. /config/permissions.yaml (defaults match the spec)
PERMISSIONS_FILE=
# default: claude.ai and claude.com MCP callbacks (+ loopback)
ALLOWED_REDIRECT_URIS=
# default: claude.ai,claude.com
CIMD_ALLOWED_HOSTS=
TRUST_PROXY=1
GIT_AUTHOR_NAME=AIsidian
GIT_AUTHOR_EMAIL=aisidian@localhost

# --- Web UI
# public URL routed by the Cloudflare Tunnel to WEB_PORT (http://localhost:8090 for a local test)
WEB_PUBLIC_URL=https://vault.example.com
WEB_PORT=8090

# --- Backups
# DAS mount on the Docker host
RESTIC_REPOSITORY_PATH=/mnt/backup/aisidian-restic
RESTIC_PASSWORD=change-me
BACKUP_MINUTE=5

# --- Fallback (only with --profile fallback)
OBSIDIAN_FALLBACK_PORT=3000
